{
  "name": "codefleet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CodeFleet v0.1 CLI for orchestrating Codex-based development tasks.",
  "bin": {
    "codefleet": "./src/cli.ts"
  },
  "scripts": {
    "codefleet": "node ./src/cli.ts",
    "pretest": "node ./scripts/reset-rule-coverage.mjs",
    "test": "node --test",
    "posttest": "node ./scripts/check-rule-coverage.mjs && node ./scripts/check-links.mjs && node ./scripts/check-doc-facts.mjs",
    "check:links": "node ./scripts/check-links.mjs",
    "check:facts": "node ./scripts/check-doc-facts.mjs",
    "coverage:baseline": "node ./scripts/check-rule-coverage.mjs --update-baseline",
    "coverage:uncovered": "node ./scripts/check-rule-coverage.mjs --list-uncovered"
  },
  "engines": {
    "node": ">=24"
  }
}

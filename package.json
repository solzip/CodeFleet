{
  "name": "codefleet",
  "version": "0.2.0-alpha.4",
  "private": true,
  "license": "MIT",
  "files": [
    "src/",
    "docs/",
    "examples/",
    "LICENSE",
    "SECURITY.md",
    "README.md",
    "README.en.md"
  ],
  "type": "module",
  "description": "Experimental AI-assisted Node and Java repair workflow with isolated verification, recovery and draft PR delivery.",
  "bin": {
    "codefleet": "./src/cli.ts",
    "codefleet-alpha": "./src/alpha/cli.mjs"
  },
  "scripts": {
    "codefleet": "node ./src/cli.ts",
    "pretest": "node ./scripts/reset-rule-coverage.mjs",
    "test": "npm run test:legacy && npm run test:alpha && npm run test:host-core",
    "test:legacy": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=tap --test-reporter-destination=.rule-coverage/test-summary.tap test/*.ts",
    "test:alpha": "node --test test/alpha.test.mjs test/alpha-java.test.mjs test/providers.test.mjs test/intent.test.mjs test/workflow.test.mjs test/hybrid.test.mjs test/product.test.mjs test/model-api.test.mjs test/model-transport.test.mjs test/host.test.mjs test/operator.test.mjs test/operator-runtime.test.mjs test/host-ipc.test.mjs test/host-planning.test.mjs test/bootstrap.test.mjs",
    "test:host-core": "node --test test/host-core.test.mjs test/verification-backends.test.mjs",
    "test:host-planning": "node --test test/host-planning.test.mjs",
    "test:host-ipc": "node --test test/host-ipc.test.mjs",
    "test:operator-runtime": "node --test test/operator-runtime.test.mjs",
    "test:operator": "node --test test/operator.test.mjs",
    "test:host": "node --test test/host.test.mjs",
    "alpha:doctor": "node src/alpha/cli.mjs doctor",
    "alpha:smoke": "node scripts/alpha-smoke.mjs --real-provider",
    "alpha:package-smoke": "node scripts/alpha-package-smoke.mjs",
    "posttest": "node ./scripts/check-rule-coverage.mjs && node ./scripts/check-links.mjs && node ./scripts/check-doc-citations.mjs && node ./scripts/check-doc-facts.mjs",
    "check:links": "node ./scripts/check-links.mjs",
    "check:facts": "node ./scripts/check-doc-facts.mjs",
    "check:citations": "node ./scripts/check-doc-citations.mjs",
    "anchors:baseline": "node ./scripts/check-doc-facts.mjs --update-baseline",
    "coverage:baseline": "node ./scripts/check-rule-coverage.mjs --update-baseline",
    "coverage:uncovered": "node ./scripts/check-rule-coverage.mjs --list-uncovered"
  },
  "engines": {
    "node": ">=24.14.1"
  }
}
